# Copy thành apps/web/.env.local (KHÔNG commit). Giá trị lấy từ SETUP-OWNER.md bước S4.
# Firebase web config không phải secret nhưng vẫn đọc qua biến môi trường.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# true = dùng Firebase Auth Emulator (127.0.0.1:9099) thay cho Firebase thật — dev local & E2E.
VITE_USE_AUTH_EMULATOR=false

# Phase 2 (M12.5): true mới hiện nút "Tiếp tục với Facebook". Phase 1 giữ false.
VITE_ENABLE_FACEBOOK_LOGIN=false

# M12.9 Luyện nói: không đặt → bật khi `pnpm dev`, tắt khi `pnpm build`. CI: preview PR = true,
# production = false (giai đoạn CAT) — chỉ đổi khi owner phát hành (T12.9.8).
# VITE_ENABLE_SPEAKING=true
