{
  "title": "vowel",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "form": {
      "type": "string",
      "pattern": "^[^–]*–[^–]*$"
    },
    "length": {
      "type": "string",
      "enum": [
        "short",
        "long"
      ]
    },
    "inherent_final": {
      "type": "string",
      "enum": [
        "y",
        "m",
        "w"
      ]
    },
    "phonetic": {
      "type": "string",
      "pattern": "^[a-z]+([- ][a-z]+)*$"
    },
    "order": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "image": {
      "type": "string",
      "pattern": "^(noto:[0-9a-f]{4,6}(-[0-9a-f]{4,6})*|img\\/[a-z0-9][a-z0-9/_-]*\\.(svg|png|webp|jpg))$"
    },
    "mnemonic_vi": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "draft": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "form",
    "length",
    "phonetic",
    "order"
  ],
  "additionalProperties": false
}
