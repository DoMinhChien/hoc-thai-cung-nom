{
  "title": "syllable-analysis",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "thai": {
      "type": "string",
      "minLength": 1,
      "pattern": "[\\u0E00-\\u0E7F]"
    },
    "initial_char": {
      "type": "string",
      "pattern": "^[ก-ฮ]$"
    },
    "leading": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "ห",
            "อ"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "vowel_length": {
      "type": "string",
      "enum": [
        "short",
        "long"
      ]
    },
    "final_sound": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "m",
            "n",
            "ng",
            "y",
            "w",
            "k",
            "t",
            "p"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "tone_mark": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "ek",
            "tho",
            "tri",
            "chattawa"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "expected_tone": {
      "type": "string",
      "enum": [
        "mid",
        "low",
        "falling",
        "high",
        "rising"
      ]
    },
    "image": {
      "type": "string",
      "pattern": "^(noto:[0-9a-f]{4,6}(-[0-9a-f]{4,6})*|img\\/[a-z0-9][a-z0-9/_-]*\\.(svg|png|webp|jpg))$"
    },
    "mnemonic_vi": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "draft": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "thai",
    "initial_char",
    "vowel_length",
    "expected_tone"
  ],
  "additionalProperties": false
}
