{
  "title": "consonant",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "char": {
      "type": "string",
      "pattern": "^[ก-ฮ]$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "[\\u0E00-\\u0E7F]"
    },
    "class": {
      "type": "string",
      "enum": [
        "mid",
        "high",
        "low"
      ]
    },
    "initial": {
      "type": "string",
      "pattern": "^[a-z]+([- ][a-z]+)*$"
    },
    "final": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z]+([- ][a-z]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "phonetic": {
      "type": "string",
      "pattern": "^[a-z]+([- ][a-z]+)*$"
    },
    "keyword_vi": {
      "type": "string",
      "minLength": 1
    },
    "order": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "image": {
      "type": "string",
      "pattern": "^(noto:[0-9a-f]{4,6}(-[0-9a-f]{4,6})*|img\\/[a-z0-9][a-z0-9/_-]*\\.(svg|png|webp|jpg))$"
    },
    "mnemonic_vi": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "draft": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "char",
    "name",
    "class",
    "initial",
    "phonetic",
    "keyword_vi",
    "order"
  ],
  "additionalProperties": false
}
