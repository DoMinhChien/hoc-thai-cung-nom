{
  "title": "word",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "unit_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "lesson_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "thai": {
      "type": "string",
      "minLength": 1,
      "pattern": "[\\u0E00-\\u0E7F]"
    },
    "meaning_vi": {
      "type": "string"
    },
    "pos": {
      "type": "string"
    },
    "phonetic": {
      "type": "string"
    },
    "example_th": {
      "type": "string"
    },
    "example_vi": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "tags": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "draft": {
      "type": "string",
      "enum": [
        "true",
        "false",
        ""
      ]
    }
  },
  "required": [
    "id",
    "unit_id",
    "lesson_id",
    "thai",
    "meaning_vi"
  ],
  "additionalProperties": false
}
