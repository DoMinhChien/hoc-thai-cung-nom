{
  "title": "tone",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "enum": [
        "mid",
        "low",
        "falling",
        "high",
        "rising"
      ]
    },
    "label_vi": {
      "type": "string",
      "minLength": 1
    },
    "chao": {
      "type": "string",
      "pattern": "^[1-5]{2,3}$"
    },
    "compare_vi": {
      "type": "string",
      "minLength": 1
    },
    "order": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "image": {
      "type": "string",
      "pattern": "^(noto:[0-9a-f]{4,6}(-[0-9a-f]{4,6})*|img\\/[a-z0-9][a-z0-9/_-]*\\.(svg|png|webp|jpg))$"
    },
    "mnemonic_vi": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "draft": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "label_vi",
    "chao",
    "order"
  ],
  "additionalProperties": false
}
