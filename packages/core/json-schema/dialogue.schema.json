{
  "title": "dialogue",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "lesson_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "lines": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "speaker": {
            "type": "string",
            "minLength": 1
          },
          "th": {
            "type": "string",
            "minLength": 1,
            "pattern": "[\\u0E00-\\u0E7F]"
          },
          "vi": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "speaker",
          "th",
          "vi"
        ],
        "additionalProperties": false
      }
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "draft": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "lesson_id",
    "lines"
  ],
  "additionalProperties": false
}
